{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "lifecycleState",
    "networkProfile",
    "networkArtifactLoader",
    "executionClient",
    "consensusClient",
    "executionClients",
    "consensusClients",
    "identity",
    "telemetry",
    "storageClassName",
    "storage",
    "p2p",
    "scheduling",
    "availability",
    "validator",
    "web3signer"
  ],
  "properties": {
    "lifecycleState": {
      "type": "string",
      "enum": [
        "active",
        "stopped",
        "archived"
      ]
    },
    "networkProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "family", "generation", "resetPolicy", "identityFingerprint", "identity", "clients", "signer"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
        "generation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
        "resetPolicy": {"enum": ["persistent", "replace-data"]},
        "identityFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executionChainId", "executionNetworkId", "executionGenesisHash", "consensusGenesisValidatorsRoot", "genesisForkVersion", "consensusGenesisTime"],
          "properties": {
            "executionChainId": {"type": "integer", "minimum": 1},
            "executionNetworkId": {"type": "integer", "minimum": 1},
            "executionGenesisHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
            "consensusGenesisValidatorsRoot": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
            "genesisForkVersion": {"type": "string", "pattern": "^0x[0-9a-fA-F]{8}$"},
            "consensusGenesisTime": {"type": "integer", "minimum": 0}
          }
        },
        "clients": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geth", "lighthouse"],
          "properties": {
            "geth": {"$ref": "#/$defs/networkAdapter"},
            "reth": {"$ref": "#/$defs/networkAdapter"},
            "erigon": {"$ref": "#/$defs/networkAdapter"},
            "besu": {"$ref": "#/$defs/networkAdapter"},
            "lighthouse": {"$ref": "#/$defs/networkAdapter"},
            "teku": {"$ref": "#/$defs/networkAdapter"}
          }
        },
        "signer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web3signer"],
          "properties": {
            "web3signer": {"$ref": "#/$defs/web3signerNetworkAdapter"}
          }
        },
        "artifactBundle": {"$ref": "#/$defs/artifactBundle"},
        "checkpointSync": {"$ref": "#/$defs/checkpointSync"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "clients": {
                "properties": {
                  "geth": {"properties": {"mode": {"const": "artifact-bundle"}}}
                }
              }
            }
          },
          "then": {
            "required": ["artifactBundle", "checkpointSync"],
            "properties": {
              "resetPolicy": {"const": "replace-data"},
              "clients": {
                "properties": {
                  "lighthouse": {"$ref": "#/$defs/artifactNetworkAdapter"}
                }
              }
            }
          },
          "else": {
            "properties": {
              "resetPolicy": {"const": "persistent"},
              "clients": {
                "properties": {
                  "lighthouse": {"$ref": "#/$defs/builtinNetworkAdapter"}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["clients"],
            "properties": {
              "clients": {
                "required": ["reth"],
                "properties": {
                  "reth": {"properties": {"mode": {"const": "artifact-bundle"}}}
                }
              }
            }
          },
          "then": {
            "required": ["artifactBundle", "checkpointSync"],
            "properties": {
              "resetPolicy": {"const": "replace-data"}
            }
          }
        },
        {
          "if": {
            "required": ["clients"],
            "properties": {
              "clients": {
                "required": ["erigon"],
                "properties": {
                  "erigon": {"properties": {"mode": {"const": "artifact-bundle"}}}
                }
              }
            }
          },
          "then": {
            "required": ["artifactBundle", "checkpointSync"],
            "properties": {
              "resetPolicy": {"const": "replace-data"}
            }
          }
        },
        {
          "if": {
            "required": ["clients"],
            "properties": {
              "clients": {
                "required": ["besu"],
                "properties": {
                  "besu": {"properties": {"mode": {"const": "artifact-bundle"}}}
                }
              }
            }
          },
          "then": {
            "required": ["artifactBundle", "checkpointSync"],
            "properties": {
              "resetPolicy": {"const": "replace-data"}
            }
          }
        }
      ]
    },
    "networkArtifactLoader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadImage", "verifyImage"],
      "properties": {
        "downloadImage": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "verifyImage": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}
      }
    },
    "executionClient": {
      "enum": ["geth", "reth", "erigon", "besu"]
    },
    "consensusClient": {
      "enum": ["lighthouse", "teku"]
    },
    "executionClients": {
      "type": "object",
      "required": ["geth"],
      "properties": {
        "geth": {
          "type": "object",
          "required": ["image", "syncMode", "metrics"],
          "properties": {
            "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
            "syncMode": {"enum": ["snap", "full"]},
            "metrics": {"$ref": "#/$defs/executionMetricsMap"}
          }
        },
        "reth": {
          "type": "object",
          "required": ["image", "metrics"],
          "additionalProperties": false,
          "properties": {
            "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
            "metrics": {"$ref": "#/$defs/executionMetricsMap"}
          }
        },
        "erigon": {
          "type": "object",
          "required": ["image", "metrics"],
          "additionalProperties": false,
          "properties": {
            "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
            "metrics": {"$ref": "#/$defs/executionMetricsMap"}
          }
        },
        "besu": {
          "type": "object",
          "required": ["image", "metrics"],
          "additionalProperties": false,
          "properties": {
            "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
            "metrics": {"$ref": "#/$defs/executionMetricsMap"}
          }
        }
      }
    },
    "consensusClients": {
      "type": "object",
      "required": ["lighthouse"],
      "properties": {
        "lighthouse": {
          "type": "object",
          "required": ["image", "metrics"],
          "additionalProperties": false,
          "properties": {
            "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
            "metrics": {"$ref": "#/$defs/consensusMetricsMap"}
          }
        },
        "teku": {
          "type": "object",
          "required": ["image", "metrics"],
          "additionalProperties": false,
          "properties": {
            "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
            "metrics": {"$ref": "#/$defs/consensusMetricsMap"}
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customerId",
        "validatorId",
        "assignmentId"
      ],
      "properties": {
        "customerId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "validatorId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "environment"
      ],
      "description": "Environment identity attached to every scraped series and retained through every recording rule. Must be set per environment; not derivable from Prometheus externalLabels, which do not apply to locally queried series.",
      "properties": {
        "cluster": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "local",
            "dev",
            "staging",
            "production"
          ]
        }
      }
    },
    "storageClassName": {
      "type": "string",
      "description": "Named explicitly per environment. An empty value is rejected because Kubernetes reads it as 'bind to a pre-provisioned volume, ignore every StorageClass', which on EKS would silently bypass the encrypted gp3 adapter.",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Chain-data claim sizes. Binary suffixes only, so environment profiles stay directly comparable. Expansion can grow these; nothing shrinks them.",
      "required": [
        "execution",
        "consensus",
        "validator"
      ],
      "properties": {
        "execution": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "consensus": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "validator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        }
      }
    },
    "p2p": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service"],
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "type", "annotations", "externalTrafficPolicy", "loadBalancerSourceRanges"],
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "annotations": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            "externalTrafficPolicy": {"enum": ["Cluster", "Local"]},
            "loadBalancerSourceRanges": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}
            }
          }
        }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferSpot"],
      "properties": {
        "preferSpot": {"type": "boolean"}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeTerminationGracePeriodSeconds",
        "validatorTerminationGracePeriodSeconds",
        "nodeDisruptionBudgetEnabled",
        "validatorDisruptionBudgetEnabled"
      ],
      "properties": {
        "nodeTerminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600
        },
        "validatorTerminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600
        },
        "nodeDisruptionBudgetEnabled": {"type": "boolean"},
        "validatorDisruptionBudgetEnabled": {"type": "boolean"}
      }
    },
    "validator": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "publicKey": {
          "type": "string"
        },
        "feeRecipient": {
          "type": "string"
        },
        "slashingProtectionConfirmed": {
          "type": "boolean"
        },
        "networkConfigMapName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        }
      }
    },
    "web3signer": {
      "type": "object",
      "required": [
        "endpoint"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validator": {
            "required": ["enabled"],
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "networkProfile": {
            "properties": {
              "signer": {
                "properties": {
                  "web3signer": {
                    "required": ["signingQualified"],
                    "properties": {"signingQualified": {"const": true}}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "builtinNetworkAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "network"],
      "properties": {
        "mode": {"const": "builtin"},
        "network": {"enum": ["sepolia", "hoodi"]}
      }
    },
    "artifactNetworkAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"const": "artifact-bundle"}
      }
    },
    "web3signerNetworkAdapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "network"],
          "properties": {
            "mode": {"const": "builtin"},
            "network": {"enum": ["sepolia", "hoodi"]},
            "signingQualified": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "signingQualified"],
          "properties": {
            "mode": {"const": "artifact-bundle"},
            "network": {"type": "null"},
            "signingQualified": {"type": "boolean"}
          }
        }
      ]
    },
    "networkAdapter": {
      "oneOf": [
        {"$ref": "#/$defs/builtinNetworkAdapter"},
        {"$ref": "#/$defs/artifactNetworkAdapter"}
      ]
    },
    "prometheusMetricName": {
      "type": "string",
      "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"
    },
    "executionMetricsMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headBlock", "peers"],
      "description": "headBlock and peers are required for every EL. headHeader is optional: only clients that expose a separately-observed downloaded-header-frontier gauge (distinct from canonical-chain height) should declare it. Clients that do not declare headHeader are omitted from both the validator_platform_execution_head_header union and the derived validator_platform_execution_internal_sync_distance rule, so those series are not published for those clients — matching PRD §12.5's 'missing telemetry is unsupported/not collected, not zero' contract.",
      "properties": {
        "headBlock": {"$ref": "#/$defs/prometheusMetricName"},
        "headHeader": {"$ref": "#/$defs/prometheusMetricName"},
        "peers": {"$ref": "#/$defs/prometheusMetricName"}
      }
    },
    "consensusMetricsMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSlot", "presentSlot", "presentEpoch", "finalizedEpoch", "peers"],
      "properties": {
        "headSlot": {"$ref": "#/$defs/prometheusMetricName"},
        "presentSlot": {"$ref": "#/$defs/prometheusMetricName"},
        "presentEpoch": {"$ref": "#/$defs/prometheusMetricName"},
        "finalizedEpoch": {"$ref": "#/$defs/prometheusMetricName"},
        "peers": {"$ref": "#/$defs/prometheusMetricName"},
        "validatorEnabled": {"$ref": "#/$defs/prometheusMetricName"}
      }
    },
    "bundlePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "artifactBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "files"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://[^?#]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executionGenesis",
            "consensusConfig",
            "consensusGenesis",
            "consensusGenesisValidatorsRoot",
            "executionBootnodes",
            "executionBootnode",
            "consensusBootnodes",
            "consensusBootnodesText",
            "nodeVariables",
            "depositContract",
            "depositContractBlock",
            "depositContractBlockHash",
            "retentionVariables"
          ],
          "properties": {
            "executionGenesis": {"$ref": "#/$defs/bundlePath"},
            "consensusConfig": {"$ref": "#/$defs/bundlePath"},
            "consensusGenesis": {"$ref": "#/$defs/bundlePath"},
            "consensusGenesisValidatorsRoot": {"$ref": "#/$defs/bundlePath"},
            "executionBootnodes": {"$ref": "#/$defs/bundlePath"},
            "executionBootnode": {"$ref": "#/$defs/bundlePath"},
            "consensusBootnodes": {"$ref": "#/$defs/bundlePath"},
            "consensusBootnodesText": {"$ref": "#/$defs/bundlePath"},
            "nodeVariables": {"$ref": "#/$defs/bundlePath"},
            "depositContract": {"$ref": "#/$defs/bundlePath"},
            "depositContractBlock": {"$ref": "#/$defs/bundlePath"},
            "depositContractBlockHash": {"$ref": "#/$defs/bundlePath"},
            "retentionVariables": {"$ref": "#/$defs/bundlePath"}
          }
        }
      }
    },
    "checkpointSync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryUrl", "verificationUrls"],
      "properties": {
        "primaryUrl": {"type": "string", "pattern": "^https://[^?#]+$"},
        "verificationUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://[^?#]+$"}
        }
      }
    }
  }
}
