{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "lifecycleState",
    "network",
    "executionClient",
    "consensusClient",
    "identity",
    "telemetry",
    "storageClassName",
    "storage",
    "validator",
    "web3signer"
  ],
  "properties": {
    "lifecycleState": {
      "type": "string",
      "enum": [
        "active",
        "stopped",
        "archived"
      ]
    },
    "network": {
      "type": "string",
      "enum": [
        "sepolia",
        "hoodi"
      ]
    },
    "executionClient": {
      "const": "geth"
    },
    "consensusClient": {
      "const": "lighthouse"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customerId",
        "validatorId",
        "assignmentId"
      ],
      "properties": {
        "customerId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "validatorId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "environment"
      ],
      "description": "Environment identity attached to every scraped series and retained through every recording rule. Must be set per environment; not derivable from Prometheus externalLabels, which do not apply to locally queried series.",
      "properties": {
        "cluster": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "local",
            "dev",
            "staging",
            "production"
          ]
        }
      }
    },
    "storageClassName": {
      "type": "string",
      "description": "Named explicitly per environment. An empty value is rejected because Kubernetes reads it as 'bind to a pre-provisioned volume, ignore every StorageClass', which on EKS would silently bypass the encrypted gp3 adapter.",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Chain-data claim sizes. Binary suffixes only, so environment profiles stay directly comparable. Expansion can grow these; nothing shrinks them.",
      "required": [
        "execution",
        "consensus",
        "validator"
      ],
      "properties": {
        "execution": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "consensus": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "validator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        }
      }
    },
    "validator": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "publicKey": {
          "type": "string"
        },
        "feeRecipient": {
          "type": "string"
        },
        "slashingProtectionConfirmed": {
          "type": "boolean"
        }
      }
    },
    "web3signer": {
      "type": "object",
      "required": [
        "endpoint"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    }
  }
}
