{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.galaxy-lab/schemas/network-profile.schema.json",
  "title": "NetworkProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.galaxy-lab/v1alpha1"},
    "kind": {"const": "NetworkProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "generation", "resetPolicy", "identity", "clients", "signer", "deposit"],
      "properties": {
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
        "generation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
        "resetPolicy": {"enum": ["persistent", "replace-data"]},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executionChainId",
            "executionNetworkId",
            "executionGenesisHash",
            "consensusGenesisValidatorsRoot",
            "genesisForkVersion",
            "consensusGenesisTime"
          ],
          "properties": {
            "executionChainId": {"type": "integer", "minimum": 1},
            "executionNetworkId": {"type": "integer", "minimum": 1},
            "executionGenesisHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
            "consensusGenesisValidatorsRoot": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
            "genesisForkVersion": {"type": "string", "pattern": "^0x[0-9a-fA-F]{8}$"},
            "consensusGenesisTime": {"type": "integer", "minimum": 0}
          }
        },
        "artifactBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "files"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://[^?#]+$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "files": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "executionGenesis",
                "consensusConfig",
                "consensusGenesis",
                "consensusGenesisValidatorsRoot",
                "executionBootnodes",
                "executionBootnode",
                "consensusBootnodes",
                "consensusBootnodesText",
                "nodeVariables",
                "depositContract",
                "depositContractBlock",
                "depositContractBlockHash",
                "retentionVariables"
              ],
              "properties": {
                "executionGenesis": {"$ref": "#/$defs/bundlePath"},
                "consensusConfig": {"$ref": "#/$defs/bundlePath"},
                "consensusGenesis": {"$ref": "#/$defs/bundlePath"},
                "consensusGenesisValidatorsRoot": {"$ref": "#/$defs/bundlePath"},
                "executionBootnodes": {"$ref": "#/$defs/bundlePath"},
                "executionBootnode": {"$ref": "#/$defs/bundlePath"},
                "consensusBootnodes": {"$ref": "#/$defs/bundlePath"},
                "consensusBootnodesText": {"$ref": "#/$defs/bundlePath"},
                "nodeVariables": {"$ref": "#/$defs/bundlePath"},
                "depositContract": {"$ref": "#/$defs/bundlePath"},
                "depositContractBlock": {"$ref": "#/$defs/bundlePath"},
                "depositContractBlockHash": {"$ref": "#/$defs/bundlePath"},
                "retentionVariables": {"$ref": "#/$defs/bundlePath"}
              }
            }
          }
        },
        "clients": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geth", "lighthouse"],
          "properties": {
            "geth": {"$ref": "#/$defs/gethAdapter"},
            "lighthouse": {"$ref": "#/$defs/lighthouseAdapter"}
          }
        },
        "signer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web3signer"],
          "properties": {
            "web3signer": {"$ref": "#/$defs/web3signerAdapter"}
          }
        },
        "checkpointSync": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primaryUrl", "verificationUrls"],
          "properties": {
            "primaryUrl": {"type": "string", "pattern": "^https://[^?#]+$"},
            "verificationUrls": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^https://[^?#]+$"}
            }
          }
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intervalSeconds", "successorPolicy"],
          "properties": {
            "intervalSeconds": {"type": "integer", "minimum": 1},
            "successorPolicy": {"const": "explicit-reviewed-pr"}
          }
        },
        "deposit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractAddress", "deployBlock"],
          "properties": {
            "contractAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
            "deployBlock": {"type": "integer", "minimum": 0},
            "launchpadUrl": {"type": "string", "pattern": "^https://[^?#]+$"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"resetPolicy": {"const": "replace-data"}}},
          "then": {"required": ["artifactBundle", "reset"]}
        },
        {
          "if": {
            "properties": {
              "clients": {
                "properties": {
                  "geth": {"properties": {"mode": {"const": "artifact-bundle"}}}
                }
              }
            }
          },
          "then": {
            "required": ["artifactBundle", "checkpointSync"],
            "properties": {"resetPolicy": {"const": "replace-data"}}
          }
        },
        {
          "if": {
            "properties": {
              "clients": {
                "properties": {
                  "lighthouse": {"properties": {"mode": {"const": "artifact-bundle"}}}
                }
              }
            }
          },
          "then": {
            "required": ["artifactBundle", "checkpointSync"],
            "properties": {"resetPolicy": {"const": "replace-data"}}
          }
        },
        {
          "if": {
            "properties": {
              "signer": {
                "properties": {
                  "web3signer": {"properties": {"mode": {"const": "artifact-bundle"}}}
                }
              }
            }
          },
          "then": {"required": ["artifactBundle"]}
        }
      ]
    }
  },
  "$defs": {
    "gethAdapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "network"],
          "properties": {
            "mode": {"const": "builtin"},
            "network": {"enum": ["sepolia", "hoodi"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"const": "artifact-bundle"}
          }
        }
      ]
    },
    "lighthouseAdapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "network"],
          "properties": {
            "mode": {"const": "builtin"},
            "network": {"enum": ["sepolia", "hoodi"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"const": "artifact-bundle"}
          }
        }
      ]
    },
    "web3signerAdapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "network"],
          "properties": {
            "mode": {"const": "builtin"},
            "network": {"enum": ["sepolia", "hoodi"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"const": "artifact-bundle"}
          }
        }
      ]
    },
    "bundlePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
