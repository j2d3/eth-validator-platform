{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.galaxy-lab/schemas/service-profile.schema.json",
  "title": "ServiceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.galaxy-lab/v1alpha1"},
    "kind": {"const": "ServiceProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionClient", "consensusClient", "tenancy", "resourceProfile", "signingAllowed"],
      "properties": {
        "executionClient": {"enum": ["geth", "nethermind", "besu", "reth"]},
        "consensusClient": {"enum": ["lighthouse", "prysm", "teku", "nimbus"]},
        "tenancy": {"enum": ["dedicated", "shared"]},
        "resourceProfile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
        "signingAllowed": {"type": "boolean"}
      }
    }
  }
}
