{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.galaxy-lab/schemas/validator-identity.schema.json",
  "title": "ValidatorIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.galaxy-lab/v1alpha1"},
    "kind": {"const": "ValidatorIdentity"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customerRef", "networkProfileRef", "lifecycle", "synthetic"],
      "properties": {
        "customerRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
        "networkProfileRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
        "lifecycle": {"enum": ["draft", "registered", "retired"]},
        "synthetic": {"type": "boolean"},
        "publicKey": {"type": "string", "pattern": "^0x[0-9a-fA-F]{96}$"},
        "signingSecretRef": {"type": "string", "pattern": "^(aws-sm|local-secret)://[A-Za-z0-9._/-]+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"lifecycle": {"const": "registered"}}},
          "then": {"required": ["publicKey", "signingSecretRef"]}
        }
      ]
    }
  }
}
