aws_region = "us-west-2"

# Use your trusted operator workstation /32. GitHub Actions has no AWS authority.
cluster_public_access_cidrs = ["203.0.113.10/32"]

# One NAT is a conscious lab cost optimization and an AZ-level egress dependency.
single_nat_gateway = true

# The three zero-minimum Ethereum groups are scoped to one AZ each. These inputs
# select capacity only when the groups are first created. The pinned EKS module
# intentionally ignores later desired-size edits; bounded pause/resume uses the
# EKS scaling API after the GitOps stop gate. Do not resume in another AZ after
# an EBS PVC binds without an explicit volume migration.
ethereum_initial_active_az_index = 0
ethereum_initial_desired_size    = 1

# Keep the copy-paste path on demand. Change this reviewed operator input to
# SPOT only for the explicit testnet interruption experiment.
ethereum_capacity_type = "ON_DEMAND"

# Disposable node roots only; chain databases use separate EBS CSI PVCs.
system_root_volume_size_gib   = 40
ethereum_root_volume_size_gib = 30

# The shared slashing-protection database is deliberately small and Single-AZ
# for the testnet lab. PostgreSQL 18.4 and db.t4g.micro + 20-GiB gp3 were
# observed as orderable in us-west-2 on 2026-08-02; Terraform pins the major so
# AWS can apply compatible minor patches. The defaults retain seven days of
# PITR and require deletion protection plus a final snapshot.
rds_postgres_major_version    = "18"
rds_instance_class            = "db.t4g.micro"
rds_allocated_storage_gib     = 20
rds_max_allocated_storage_gib = 100
rds_backup_retention_days     = 7
rds_log_retention_days        = 7
rds_deletion_protection       = true
rds_skip_final_snapshot       = false

# Add an operator role if the cluster creator should not be the only administrator.
access_entries = {
  # operator = {
  #   principal_arn = "arn:aws:iam::123456789012:role/eth-validator-operator"
  #   policy_associations = {
  #     admin = {
  #       policy_arn = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
  #       access_scope = { type = "cluster" }
  #     }
  #   }
  # }
}
